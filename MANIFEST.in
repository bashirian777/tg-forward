include README.md CONTRIBUTING.md Makefile .env.example requirements.txt restart.sh
include src/__init__.py src/main.py
recursive-include docs *.md
recursive-include scripts *.py
recursive-include tests *.py
recursive-include frontend *.json *.ts *.vue *.css *.html
prune frontend/node_modules
prune frontend/dist
prune frontend/test-results
prune frontend/playwright-report
prune data
prune .pi
global-exclude __pycache__ *.py[cod] *.session *.session-* *.db *.db-*
