# Telegram 用户账号（从 https://my.telegram.org 获取 API 凭据）
TG_API_ID=
TG_API_HASH=
TG_PHONE=

# 首次 Web 管理密码；已有数据库通过设置页修改
WEB_INITIAL_PASSWORD=

# Web 监听地址和端口，修改后重启生效
WEB_HOST=0.0.0.0
WEB_PORT=10082

# 可选：管理 Bot；管理员 ID 用英文逗号分隔
TG_BOT_TOKEN=
TG_ADMIN_IDS=

# 可选：Telegram 连接代理，如 socks5://用户名:密码@代理主机:1080
TG_PROXY_URL=
