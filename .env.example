# Telegram 用户账号（从 https://my.telegram.org 获取 API 凭据）
TG_API_ID=
TG_API_HASH=
TG_PHONE=

# 可选：启用管理 Bot 时填写，管理员 ID 用英文逗号分隔
TG_BOT_TOKEN=
TG_ADMIN_IDS=

# Docker 目录挂载的运行用户，默认兼容自动创建的 root 目录
# 使用普通用户时填宿主机 id -u / id -g 的结果，并确保 data/、temp/ 可写
DOCKER_UID=0
DOCKER_GID=0

# 源码运行时相对路径按项目目录解析；Compose 固定为 /app/data 下的路径
DB_PATH=data/forwarder.db
SESSION_PATH=data/sessions/forwarder.session

# Web 监听参数，修改后重启生效；Compose 固定容器监听 0.0.0.0:10082
WEB_HOST=127.0.0.1
WEB_PORT=10082

# 可选：HTTPS 反向代理的单个 IP；设置后信任它提供的协议和客户端 IP
# 与本机 Nginx 配合时填写 127.0.0.1；直接访问或 SSH 隧道留空
WEB_TRUSTED_PROXY=

# 仅首次 init 使用；已有数据库的密码通过后台修改
WEB_INITIAL_PASSWORD=

# 可选：socks5://用户名:密码@127.0.0.1:1080（也支持 socks4/http）
# Docker 访问宿主机代理时，主机使用 host.docker.internal
TG_PROXY_URL=
