# Telegram 用户账号（从 https://my.telegram.org 获取 API 凭据）
TG_API_ID=
TG_API_HASH=
TG_PHONE=

# 可选：启用管理 Bot 时填写，管理员 ID 用英文逗号分隔
TG_BOT_TOKEN=
TG_ADMIN_IDS=

# 相对路径以项目目录为基准
DB_PATH=config/forwarder.db
SESSION_PATH=forwarder.session

# Web 监听参数，修改后重启生效
WEB_HOST=127.0.0.1
WEB_PORT=10082

# 仅首次 init 使用；已有数据库的密码通过后台修改
WEB_INITIAL_PASSWORD=

# 可选：socks5://用户名:密码@127.0.0.1:1080（也支持 socks4/http）
TG_PROXY_URL=
