# Telegram 用户账号（从 https://my.telegram.org 获取 API 凭据）
TG_API_ID=
TG_API_HASH=
TG_PHONE=

# 首次 Web 管理密码；已有数据库通过设置页修改
WEB_INITIAL_PASSWORD=

# Web 监听地址和端口，修改后重启生效
WEB_HOST=0.0.0.0
WEB_PORT=10082

# 可选：管理 Bot；留空不影响网页管理
# 启用时 token 和管理员用户 ID 都需填写，多个 ID 用英文逗号分隔
# 网页不支持修改这两项；修改后需重启进程或重新创建 Docker 容器
TG_BOT_TOKEN=
TG_ADMIN_IDS=

# 可选：Telegram 连接代理，如 socks5://用户名:密码@代理主机:1080
TG_PROXY_URL=
